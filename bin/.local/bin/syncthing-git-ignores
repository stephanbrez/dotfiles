#!/usr/bin/env bash

# *Syncthing-Git-Ignores* - Keep Syncthing from duplicating git's job.
#
# Scans the top level of a Syncthing-managed source directory and writes a
# generated ignore file listing every project that already has a git remote.
# Those repos are replicated by git, so Syncthing syncing them adds conflict
# risk (notably inside .git/) with no benefit. Repos with NO remote are left
# alone: for those, Syncthing is the only backup.
#
# The generated file is pulled into .stignore via a "#include" line, so your
# hand-written patterns and this generated list stay cleanly separated.
#
# USAGE:
#   syncthing-git-ignores [--dry-run] [--quiet]
#
# ENVIRONMENT:
#   SYNCTHING_SRC_ROOT    source dir to scan   (default: ~/.local/src)
#   SYNCTHING_CONFIG      config.xml location  (default: XDG state dir)
#
# EXIT CODES:
#   0 ok (whether or not anything changed)   1 error

set -euo pipefail

# ===== Configuration =====

SRC_ROOT="${SYNCTHING_SRC_ROOT:-$HOME/.local/src}"
SYNCTHING_CONFIG="${SYNCTHING_CONFIG:-$HOME/.local/state/syncthing/config.xml}"
FOLDER_ID="local-src"
GENERATED_NAME=".stignore.generated"
GENERATED="$SRC_ROOT/$GENERATED_NAME"
STIGNORE="$SRC_ROOT/.stignore"
INCLUDE_LINE="#include $GENERATED_NAME"

DRY_RUN=0
QUIET=0

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --quiet)   QUIET=1 ;;
        -h|--help) sed -n '3,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "⚠️  unknown argument: $arg" >&2; exit 1 ;;
    esac
done

say() { [ "$QUIET" -eq 1 ] || echo "$@"; }

# ===== Helpers =====

# ─── A repo is "git-managed" if it has at least one remote ───
has_remote() {
    local dir="$1"
    [ -e "$dir/.git" ] || return 1
    [ -n "$(git -C "$dir" remote 2>/dev/null)" ]
}

# ─── Syncthing treats these as glob metacharacters ───
has_glob_chars() {
    case "$1" in
        *'*'* | *'?'* | *'['* | *']'* | *'{'* | *'}'* | *'\'*) return 0 ;;
        *) return 1 ;;
    esac
}

# ===== Scan =====

[ -d "$SRC_ROOT" ] || { echo "⚠️  no such directory: $SRC_ROOT" >&2; exit 1; }

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

{
    echo "// Generated by syncthing-git-ignores -- DO NOT EDIT."
    echo "// Every project below has a git remote, so git already"
    echo "// replicates it. Add hand-written patterns to .stignore."
    echo "//"
    echo "// Regenerate: syncthing-git-ignores"
} >"$tmp"

managed=0
unmanaged=0
skipped=0

for dir in "$SRC_ROOT"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"

    if ! has_remote "$dir"; then
        unmanaged=$((unmanaged + 1))
        continue
    fi

    # ⚠️ A name containing glob metacharacters would be interpreted as a
    # pattern rather than a literal directory, so refuse to guess.
    if has_glob_chars "$name"; then
        echo "⚠️  skipping '$name': glob characters in name" >&2
        skipped=$((skipped + 1))
        continue
    fi

    # Leading slash anchors to the folder root, so a nested directory
    # that happens to share this name is not caught by accident.
    echo "/$name/" >>"$tmp"
    managed=$((managed + 1))
done

# ===== Apply =====

if [ -f "$GENERATED" ] && cmp -s "$tmp" "$GENERATED"; then
    say "✅ up to date: $managed git-managed, $unmanaged synced"
    exit 0
fi

if [ "$DRY_RUN" -eq 1 ]; then
    say "🔍 would write $GENERATED:"
    grep -v '^//' "$tmp" || true
    say "($managed git-managed, $unmanaged synced, $skipped skipped)"
    exit 0
fi

cp "$tmp" "$GENERATED"
say "✏️  wrote $GENERATED ($managed git-managed, $unmanaged synced)"
[ "$skipped" -eq 0 ] || say "⚠️  $skipped directory(ies) skipped -- see warnings above"

# ─── .stignore must pull in the generated file ───
if [ ! -f "$STIGNORE" ] || ! grep -qxF "$INCLUDE_LINE" "$STIGNORE"; then
    echo "⚠️  $STIGNORE is missing the line: $INCLUDE_LINE" >&2
    echo "    Ignores will NOT include the generated list until added." >&2
fi

# ===== Tell Syncthing to re-read =====

# Best-effort: a rescan makes the new ignores take effect immediately
# instead of at the next scheduled scan. Never fatal.
if [ -r "$SYNCTHING_CONFIG" ] && command -v curl >/dev/null 2>&1; then
    api_key="$(grep -oP '(?<=<apikey>)[^<]+' "$SYNCTHING_CONFIG" | head -1 || true)"
    gui_addr="$(sed -n '/<gui /,/<\/gui>/p' "$SYNCTHING_CONFIG" \
        | grep -oP '(?<=<address>)[^<]+' | head -1 || true)"
    gui_addr="${gui_addr:-127.0.0.1:8384}"

    if [ -n "$api_key" ]; then
        for scheme in https http; do
            if curl -sk -m 5 -X POST -H "X-API-Key: $api_key" \
                "$scheme://$gui_addr/rest/db/scan?folder=$FOLDER_ID" \
                >/dev/null 2>&1; then
                say "🔄 requested rescan of '$FOLDER_ID'"
                break
            fi
        done
    fi
fi
